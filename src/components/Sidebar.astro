---
import { getCollection } from 'astro:content'; 

const projects = await getCollection('projects'); // reads every file in /src/content/projects 
const coursework = await getCollection('coursework'); // reads every file in /src/content/coursework 
const normalizePath = (path: string) => path.replace(/\/$/, '') || '/';
const currentPath = normalizePath(Astro.url.pathname);
const shortPath = currentPath.split("/").pop();

---
<!-- Michael DeVito II -->
<style>
	/* CSS for terminal sidebar */

	#terminal {
		padding: 1rem 1.25rem;
	}

	.terminal.is-hidden {
		display: none;
	}

	#nav-toggle {
		display: none;
	}

	.terminal-title {
		color: #2a5c84;
	}

	.terminal-title a::before {
		content: '';
	}

	.terminal-prompt {
		color: #2a5c84;
	}

	.terminal-command {
		color: #3767aa;
	}

	#blink {
		color: #3767aa;
	}

	#blink::after {
		content: '_';
		animation: blink 1s step-end infinite;
		margin-left: 2px;
	}

	@keyframes blink {
		50% { opacity: 0; }
	}

	.terminal-nav {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		font-size: 18px;
	}

	.terminal-nav > * {
		margin: 0;
	}

	.terminal-nav summary {
		cursor: pointer;
		color: #3767aa;
		list-style: none;
		text-decoration: none;
	}
	.terminal-nav summary:hover {
		color: #4eaaf6;
	}

	.terminal-nav summary .link-text {
		color: #7dd3fc;
	}

	.terminal-nav summary::-webkit-details-marker {
		display: none;
	}

	.terminal-nav summary::before {
		content: 'drwxr-xr-x   ';
		color: #2a5c84;
	}

	.nav-link {
		margin-left: 2rem;
	}

	.terminal-nav a {
		color: #7dd3fc;
		text-decoration: none;
	}

	.terminal-nav .link-text {
		text-decoration: underline;
		text-decoration-color: #3767aa;
		text-underline-offset: 0.2em;
	}

	.terminal-nav a.terminal-command .link-text {
		color: #7dd3fc;
	}

	.terminal-nav li {
		margin: 0;
		padding: 0;
	}

	.terminal-nav ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.terminal-nav h2 {
		font-size: 40px;
	}

	.terminal-nav details {
		margin: 0;
		padding: 0;
	}

	.file::before {
		content: '-rw-r--r--   ';
		color: #2a5c84;
	}

	.terminal-nav a:hover {
		color: #4eaaf6;
	}

	.terminal-nav a:hover .link-text,
	.terminal-nav summary:hover .link-text {
		color: #4eaaf6;
		text-decoration-color: currentColor;
	}

	.terminal-nav a.is-active {
		color: #4eaaf6;
	}

	@media (max-width: 700px) {
		#nav-toggle {
			display: block;
			position: absolute;
			top: 1rem;
			right: 1rem;
			z-index: 10;
			background: none;
			border: none;
			color: #c8d6c0;
			font-size: 1.5rem;
			cursor: pointer;
		}
	}

</style>

<button id="nav-toggle" aria-label="Toggle navigation" aria-controls="terminal" aria-expanded="true">
	☰
</button>

<div id="terminal">
	<nav class="terminal-nav">
		<!-- <h2 class="terminal-title"><a href="/">{SITE_TITLE}</a></h2> May end up using later to show which page you are on-->
		
		<p><span class="terminal-prompt">guest@mdevito:~$ </span><a href="/" class="terminal-command"><span class="link-text">cd /var/log/michael</span></a></p>
		<p><span class="terminal-prompt">guest@mdevito:/var/log/michael$</span><span class="terminal-command"> ls -la</span><span id="blink"> </span></p>

		<details open={currentPath.startsWith('/projects/')}>
			<summary><span class="link-text">&gt; projects/</span></summary>
			<ul>
				{ projects.map((project) => (
					<li>
						<a
							class:list={['nav-link', 'file', { 'is-active': currentPath === `/projects/${project.id}` }]}
							aria-current={currentPath === `/projects/${project.id}` ? 'page' : undefined}
							href={`/projects/${project.id}`}
						><span class="link-text">{project.data.title}</span></a>
					</li>
				))}
			</ul>
		</details>
		<details open={currentPath.startsWith('/coursework/')}>
			<summary><span class="link-text">&gt; coursework/</span></summary>
			<ul>
				{ coursework.map((work) => (
					<li>
						<a
							class:list={['nav-link', 'file', { 'is-active': currentPath === `/coursework/${work.id}` }]}
							aria-current={currentPath === `/coursework/${work.id}` ? 'page' : undefined}
							href={`/coursework/${work.id}`}
						><span class="link-text">{work.data.title}</span></a>
					</li>
				))}
			</ul>
		</details>
		<a class="file" href="/certs"><span class="link-text">certs.md</span></a>
		<a class="file" href="/resume"><span class="link-text">resume.md</span></a>

		<p><span class="terminal-prompt" id="cat">guest@mdevito:~$</span><span class="terminal-command"> cat {shortPath === "" ? "index.html" : shortPath}</span></p>

	</nav>
</div>

<script>
	const toggle = document.querySelector('#nav-toggle');
	const terminal = document.querySelector('#terminal');
	const normalizePath = (path: string) => path.replace(/\/$/, '') || '/';

	const syncActiveLink = () => {
		const currentPath = normalizePath(window.location.pathname);

		document.querySelectorAll<HTMLAnchorElement>('.terminal-nav a[href]').forEach((link) => {
			const isActive = normalizePath(new URL(link.href).pathname) === currentPath;
			link.classList.toggle('is-active', isActive);

			if (isActive) {
				link.setAttribute('aria-current', 'page');
				link.closest('details')?.setAttribute('open', '');
			} else {
				link.removeAttribute('aria-current');
			}
		});
	};

	toggle?.addEventListener('click', () => {
		const isHidden = terminal?.classList.toggle('is-hidden');
		toggle.setAttribute('aria-expanded', String(!isHidden));
	});

	syncActiveLink();
	document.addEventListener('astro:page-load', syncActiveLink);
	

</script>