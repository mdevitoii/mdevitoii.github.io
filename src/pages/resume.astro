---
import Main from '../layouts/Main.astro';
---
<!-- Michael DeVito II -->
<Main title="Resume">
	<h1 class="post-title">Resume</h1>
	<p>
		<a href="/MDeVito-Resume.pdf" target="_blank" rel="noreferrer">Open in a new tab</a>
	</p>
	<iframe
		src="/MDeVito-Resume.pdf"
		title="Michael DeVito II resume"
		width="100%"
		height="900"
	></iframe>
</Main>

<style>
	.post-title {
		margin-bottom: 0.75rem;
		text-decoration-line: underline;
		text-decoration-color: #94a3b8;
		text-decoration-thickness: 3px;
		text-underline-offset: 0.18em;
	}

	iframe {
		border: 1px solid #334155;
		background: white;
	}
</style>
