---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Main from '../../layouts/Main.astro';

export async function getStaticPaths() {
	const posts = await getCollection('projects');
	return posts.map((post) => ({
		params: { id: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'projects'>;

const post = Astro.props;
const { Content } = await render(post);
const updatedDate = post.data.updatedDate?.toLocaleDateString();
const keywords = post.data.keywords;

---
<!-- Michael DeVito II -->
<Main>
	<h1 class="post-title">{post.data.title}</h1>
	<p class="post-meta">{keywords && `Keywords: ${keywords}`}</p>
	<p class="post-meta">{updatedDate && `Last Updated ${updatedDate}`}</p>
	<div class="markdown-content">
		<Content />
	</div>
</Main>

<style>
	.post-title {
		margin-bottom: 0.75rem;
		text-decoration-line: underline;
		text-decoration-color: #94a3b8;
		text-decoration-thickness: 3px;
		text-underline-offset: 0.25em;
	}

	.post-meta {
		margin: 0 0 2rem;
		padding-left: 0.85rem;
		border-left: 2px solid #334155;
		color: #94a3b8;
		font-size: 0.85em;
		font-style: italic;
		line-height: 1.5;
	}

	.post-meta:first-of-type {
		margin-bottom: 0.25rem;
	}
</style>
