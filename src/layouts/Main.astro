---
import { ClientRouter } from 'astro:transitions';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Sidebar from '../components/Sidebar.astro'; 

const { title, description, image, imageAlt = '' } = Astro.props;
---

<!-- Michael DeVito II -->
<!DOCTYPE html>
<html lang="en">

    <head>
        <BaseHead title={title} description={description} />
        <ClientRouter />
    </head>
    <body>
        <div class="page-layout">
            <header class="header">
                <a href="/">/var/log/michael</a>
                <nav class="header-links" aria-label="Contact links">
                    <a href="https://www.linkedin.com/in/mdevitoii">LinkedIn</a>
                    <a href="https://github.com/mdevitoii">GitHub</a>
                    <a href="mailto:mdevitoii04@gmail.com">Email</a>
                </nav>
            </header>

            <aside class="sidebar">
                <div class="terminal">
                    <div class="terminal-bar">guest@mdevito:~</div>
                    <Sidebar />
                </div>
            </aside>

            <main class="content">
                {image && <img class="content-image" src={image} alt={imageAlt} />}
                <slot />
            </main>

            <footer class="footer">
                <Footer />
            </footer>

        </div>
    </body>
</html>

<style>

    :global(:root) {
        --header-height: 64px;
    }

    .page-layout {
        min-height: 100vh;
        display: grid;
        grid-template-columns: 25vw minmax(0, 1fr);
        grid-template-rows: var(--header-height) 1fr auto;
        grid-template-areas: 
            "header header"
            "sidebar content"
            "footer footer";
    }

    .header {
        grid-area: header;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        box-sizing: border-box;
        padding: 1rem 1rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        border-bottom: 1px solid #334155;
        background: #0b0e14;
        z-index: 20;
    }

    .header a {
        color: #94a3b8;;
        text-decoration: none;
        font-weight: bold;
    }

    .header-links {
        display: flex;
        gap: 1rem;
        font-size: 0.85rem;
    }

    .header-links a {
        font-weight: normal;
    }

    .sidebar {
        grid-area: sidebar;
        position: fixed;
        top: var(--header-height);
        left: 0;
        width: 25vw;
        height: calc(100vh - var(--header-height));
        box-sizing: border-box;
        overflow-y: auto;
        padding: 0;
        z-index: 1;
    }

    .terminal {
        overflow: hidden;
        width: 100%;
        height: 100%;
        box-sizing: border-box;
        border: 1px solid #334155;
        border-radius: 0;
        background: #0b0e14;
    }

    .terminal-bar {
        padding: 0.75rem 1rem;
        border-bottom: 1px solid #334155;
        color: #94a3b8;
        font: 0.85rem monospace;
    }

    .content {
        grid-area: content;
        min-width: 0;
        width: 100%;
        max-width: none;
        margin: 0;
        box-sizing: border-box;
        padding: 4rem;
        background-color: #131924;
        color: white;
    }

    .content-image {
        float: right;
        width: min(280px, 40%);
        height: auto;
        margin: 0 0 1.5rem 2rem;
    }

    .footer {
        grid-area: footer;
        position: relative;
        padding: 1rem 1rem;
        border-top: 1px solid #334155;
        background: #0b0e14;
        z-index: 2;
    }

    @media (max-width: 700px) {
        .page-layout {
            grid-template-columns: 1fr;
            grid-template-areas: 
                "header"
                "sidebar"
                "content"
                "footer";
        }

        .content {
            padding: 1rem;
        }

        .content-image {
            float: none;
            display: block;
            width: 100%;
            max-width: 100%;
            margin: 0 0 1rem;
        }

        .sidebar {
            position: static;
            width: 100%;
            height: auto;
            min-height: 0;
        }

        .terminal {
            position: static;
        }
    }
    
</style>