---
import { ClientRouter } from 'astro:transitions';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Sidebar from '../components/Sidebar.astro'; 

const { title, description } = Astro.props;
const currentPage = Astro.url.pathname === '/' ? 'index.html' : Astro.url.pathname.replace(/\/$/, '');
---

<!-- Michael DeVito II -->
<!DOCTYPE html>
<html lang="en">

    <head>
        <BaseHead title={title} description={description} />
        <ClientRouter />
    </head>
    <body>
        <div class="page-layout">
            <header class="header">
                <div class="header-brand">
                    <a href="/">/var/log/michael</a>
                    <span class="current-page" aria-current="page">[{currentPage}]</span>
                </div>
                <nav class="header-links" aria-label="Contact links">
                    <a href="https://www.linkedin.com/in/michael-devito-ii/" target="_blank">
                        <span class="icon-box" aria-hidden="true">in</span>
                        <span class="link-label">LinkedIn</span>
                    </a>
                    <a href="https://github.com/mdevitoii" target="_blank">
                        <span class="icon-box" aria-hidden="true">
                            <svg viewBox="0 0 24 24" role="img">
                                <path d="M12 .3a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.05c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.23 1.84 1.23 1.07 1.83 2.81 1.3 3.49 1 .11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.23-3.22-.12-.3-.54-1.52.12-3.17 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.29-1.23 3.29-1.23.66 1.65.24 2.87.12 3.17.77.84 1.23 1.91 1.23 3.22 0 4.61-2.8 5.63-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58A12 12 0 0 0 12 .3Z" />
                            </svg>
                        </span>
                        <span class="link-label">GitHub</span>
                    </a>
                    <a href="mailto:mdevitoii04@gmail.com">
                        <span class="icon-box" aria-hidden="true">@</span>
                        <span class="link-label">Email</span>
                    </a>
                </nav>
            </header>

            <aside class="sidebar">
                <div class="terminal">
                    <div class="terminal-bar">guest@mdevito:~</div>
                    <Sidebar />
                </div>
            </aside>

            <main class="content">
                <slot />
            </main>

            <footer class="footer">
                <Footer />
            </footer>

        </div>
    </body>
</html>

<style>

    :global(:root) {
        --header-height: 64px;
    }

    .page-layout {
        min-height: 100vh;
        display: grid;
        grid-template-columns: 25vw minmax(0, 1fr);
        grid-template-rows: var(--header-height) 1fr auto;
        grid-template-areas: 
            "header header"
            "sidebar content"
            "footer footer";
    }

    .header {
        grid-area: header;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: var(--header-height);
        box-sizing: border-box;
        padding: 1rem 1rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        border-bottom: 1px solid #334155;
        background: #0b0e14;
        z-index: 20;
    }

    .header a {
        color: #94a3b8;;
        text-decoration: none;
        font-weight: bold;
    }

    .header-brand {
        display: flex;
        align-items: baseline;
        gap: 0.75rem;
        min-width: 0;
    }

    .current-page {
        overflow: hidden;
        color: #64748b;
        font: 0.85rem monospace;
        line-height: 1;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .header > a:hover {
        text-decoration: underline;
    }

    .header-links {
        display: flex;
        gap: 2rem;
        font-size: 20px;
    }

    .header-links a {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: normal;
    }
        .header-links a:hover {
            text-decoration: none;
        }

        .header-links a:hover .link-label {
            text-decoration: underline;
        }

    .header-links .icon-box {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.5em;
        height: 1.5em;
        border: 1px solid #38bdf8;
        color: #38bdf8;
        font-size: 0.8em;
        font-weight: bold;
    }

    .header-links .icon-box svg {
        width: 1em;
        height: 1em;
        fill: currentColor;
    }

    .sidebar {
        grid-area: sidebar;
        position: fixed;
        top: var(--header-height);
        left: 0;
        width: 25vw;
        height: calc(100vh - var(--header-height));
        box-sizing: border-box;
        overflow-y: auto;
        padding: 0;
        z-index: 1;
    }

    .terminal {
        overflow: hidden;
        width: 100%;
        height: 100%;
        box-sizing: border-box;
        border: 1px solid #334155;
        border-radius: 0;
        background: #0b0e14;
    }

    .terminal-bar {
        padding: 0.75rem 1rem;
        border-bottom: 1px solid #334155;
        color: #94a3b8;
        font: 1rem monospace;
    }

    .content {
        grid-area: content;
        min-width: 0;
        width: 100%;
        max-width: none;
        margin: 0;
        box-sizing: border-box;
        padding: 2rem 4rem 4rem;
        background-color: #131924;
        color: white;
    }

    .footer {
        grid-area: footer;
        position: relative;
        padding: 1rem 1rem;
        border-top: 1px solid #334155;
        background: #0b0e14;
        z-index: 2;
    }

    @media (max-width: 700px) {
        .page-layout {
            grid-template-columns: 1fr;
            grid-template-areas: 
                "header"
                "sidebar"
                "content"
                "footer";
        }

        .content {
            padding: 1rem 1rem 5rem;
        }

        .sidebar {
            position: static;
            width: 100%;
            height: auto;
            min-height: 0;
        }

        .terminal {
            position: static;
        }
    }
    
</style>