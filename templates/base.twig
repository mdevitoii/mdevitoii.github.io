<!-- Michael DeVito II -->

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{% block title %}/var/log/michael{% endblock %}</title>
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	
	<style>

		/* Base CSS */
		:root {
			--paper: #faf6f1;
			--panel: #f1ece3;
			--ink: #2e2a26;
			--ink-soft: #7a7168;
			--rule: #e4dcd0;
			--sage: #5b7065;
		}
		
		* { box-sizing: border-box; }
		html { scroll-behavior: smooth; }

		@media (prefers-reduce-motion: reduce) {
			html { scroll-behavior: auto; }
			* { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
		}

		body {
			margin: 0;
			background: var(--paper);
			color: var(--ink);
			font-family: 'Inter', sans-serif;
			font-size: 16px;
			line-height: 1.65;
		}

		a {
			color: var(--ink);
			text-decoration: underline;
			text-decoration-color: var(--sage);
			text-underline-offset: 3px;
		}
		a:hover {
			text-decoration-color: var(--ink);
		}

		.wrap {
			max-width: 640px;
			margin: 0 auto;
			padding: 72px 24px 96px;
		}

		/* Header CSS */
		
		.prompt {
			font-family: 'JetBrains Mono', monospace;
			font-size: 0.85rem;
			color: var(--sage); margin: 0 0 14px;
		}
		.prompt .path {
			color: var(--ink-soft);
		}
		.cursor {
			display: inline-block;
			width: 7px;
			height: 0.95em;
			background: var(--sage);
			margin-left: 5px;
			vertical-align: text-bottom;
			animation: blink 1.1s steps(1) infinite;
		}

		@keyframes blink { 50% { opacity: 0; } }
		@media (prefers-reduced-motion: reduce) { .cursor { animation: none; } }
		
		.terminal {
			font-family: 'JetBrains Mono', monospace;
			font-size: 0.84rem;
			line-height: 1.9;
			background: var(--panel);
			border: 1px solid var(--rule);
			border-radius: 4px;
			padding: 18px 20px;
			margin: 26px 0 32px;
		}

		.terminal .line { color: var(--sage); }
		.terminal .line .path { color: var(--ink-soft); }
		.terminal .listing { margin: 4px 0 10px; padding-left: 2px; }
		.terminal .listing a { display: block; color: var(--ink); text-decoration: none; }
		.terminal .listing a:hover { color: var(--sage); }
		.terminal .listing .perm { color: var(--ink-soft); margin-right: 12px; }
		.terminal .out { 
			color: var(--ink-soft);
			font-family: 'Inter', sans-serif;
			font-size: 0.98rem;
			margin: 8px 0 0;
			max-width: 54ch;
		}

		h1 {
			font-family: 'Fraunces', serif;
			font-weight: 500;
			font-size: 2.6rem;
			margin: 0 0 10px;
		}
		.role {
			font-family: 'Fraunces', serif;
			font-style: italic;
			font-size: 1.15rem;
			color: var(--sage);
			margin: 0 0 22px;
		}
		.links {
			display: flex;
			flex-direction: column;
			gap: 4px;
			font-size: 0.95rem;
		}

		/* Section CSS */
		
		section { margin-bottom: 60px; }
		.section-head { margin-bottom: 24px; }
		.breadcrumb {
			display: block;
			font-family: 'JetBrains Mono', monospace;
			font-size: 0.78rem;
			color: var(--ink-soft);
			margin-bottom: 6px;
		}
		.section-head h2 {
			font-family: 'Fraunces', serif;
			font-weight: 500;
			font-size: 1.5rem;
			margin: 0 0 8px; 
		}
		.section-head .rule {
			width: 44px;
			height: 2px;
			background: var(--sage);
			border: none; 
		}

		.entry {
			padding: 20px 0;
			border-bottom: 1px solid var(--rule); 
		}
		.entry:first-child { padding-top: 0; }
		.entry:last-child { border-bottom: none; }
		.entry-title {
			display: flex;
			justify-content: space-between;
			align-items: baseline;
			gap: 12px;
			flex-wrap: wrap;
		}
		.entry-title h3 {
			font-family: 'Inter', sans-serif;
			font-weight: 600;
			font-size: 1.05rem;
			margin: 0;
		}
		.entry-meta {
			font-size: 0.88rem;
			color: var(--ink-soft);
			white-space: nowrap;
		}
		.entry-desc {
			margin: 8px 0 0;
			color: var(--ink-soft);
			font-size: 0.98rem;
			max-width: 56ch;
		}

		footer {
			margin-top: 64px;
			padding-top: 24px;
			border-top: 1px solid var(--rule);
			font-family: 'JetBrains Mono', monospace;
			font-size: 0.8rem;
			color: var(--ink-soft);
		}
		
		/* Side Terminal CSS */
		.page {
			display: flex;
			min-height: 100vh;
		}

		.terminal-pane {
			width: 340px;
			flex-shrink: 0;
			position: sticky;
			top: 0;
			height: 100vh;
			overflow-y: auto;
			background: var(--panel);
			border-right: 1px solid var(--rule);
			padding: 32px 24px;
			font-family: 'JetBrains Mono', monospace;
			font-size: 0.82rem;
			line-height: 1.8;
		}

		.content-pane {
			flex: 1;
			padding: 72px 48px;
			max-width: 680px;
		}

		.content-pane .page-content {
			display: none;
		}

		.content-pane .page-content.active {
			display: block;
		}

		.term-line {
			color: var(--sage);
		}
		
		.term-line .path {
			color: var(--ink-soft);
		}

		.term-listing {
			margin: 4px 0 14px;
		}
		
		.term-listing a {
			display: block;
			color: var(--ink);
			text-decoration: none;
		}

		.term-listing a:hover {
			color: var(--sage);
		}

		.term-listing .perm {
			color: var(--ink-soft);
			margin-right: 10px;
		}
		
		@media (max-width: 800px) {
			.page { flex-direction: column; }
			.terminal-pane { width: 100%; position: static; height: auto; }
			.content-pane { padding: 40px 24px; }
		}


	</style>
</head>
<body>
	<div class="wrap">
		{% block body %}{% endblock %}
	</div>

</body>	
</html>

